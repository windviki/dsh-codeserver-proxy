# Copy this file to .env and fill in your own values. Everything here is
# optional — unset variables fall back to the defaults shown in proxy.js.
#
# WARNING: never commit .env; it is gitignored and holds your private values.
#
# Variables use the PROXY_ prefix on purpose: dsh boots with this directory as
# its cwd and refuses any DSH_-prefixed name found in a .env there, so the
# proxy's own configuration must not collide with dsh's bootstrap namespace.

# Base path under which the proxy is reached on code-server, i.e. the
# /proxy/<port>/ subtree code-server forwards to this service.
# Tip: keep the entry on a port of your choosing (this repo's deployment uses
# /proxy/3100 + PROXY_PORT=3100) and run dsh itself on a private port
# (PROXY_UPSTREAM_PORT=3001) so it is never exposed directly — the proxy
# handles the dsh token fence automatically, so the entry needs no token.
PROXY_BASE=/proxy/3100

# Where the proxy listens (browser-facing, inside code-server's network).
PROXY_PORT=3100

# The dsh web upstream this proxy forwards to.
PROXY_UPSTREAM_HOST=127.0.0.1
PROXY_UPSTREAM_PORT=3000

# Set to 0 to NOT auto-spawn `dsh web` when the upstream is not running
# (e.g. when dsh is supervised by systemd / pm2 / a restart helper).
# PROXY_SPAWN_DSH=0

# dsh >= 0.1.2 fences the whole web UI behind a one-time launch token
# (`dsh web` prints its URL with ?token=…). When the proxy spawns dsh it
# captures the token from stdout automatically; only set this when dsh runs
# externally (PROXY_SPAWN_DSH=0) — copy the token from dsh's own output.
# PROXY_DSH_TOKEN=
