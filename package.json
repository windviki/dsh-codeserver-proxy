{
  "name": "dsh-codeserver-proxy",
  "version": "0.1.0",
  "description": "Base-path adapter so the official dsh (DeepSeek Harness) web UI works behind a self-hosted code-server's /proxy/<port>/ port forwarding.",
  "type": "module",
  "bin": {
    "dsh-codeserver-proxy": "proxy.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windviki/dsh-codeserver-proxy.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "code-server",
    "proxy",
    "base-path",
    "port-forwarding",
    "reverse-proxy"
  ],
  "scripts": {
    "start": "node proxy.js"
  }
}
